# Trinity Stack / GalileoLabs — copy to `.env` and fill in locally.
# Names and placeholders only. Never commit real secrets.
# Keys are never echoed by `python app.py --preflight`.

# ── Required (live drills / app.py) ──────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
GALILEO_API_KEY=your-galileo-api-key

# Optional alias some shells/MCP configs use — app normalizes to GALILEO_API_KEY:
# Galileo_API_Key=

# Optional: app.py also reads Galileo from ~/.openclaw/openclaw.json
#   mcp.servers.galileo.headers["Galileo-API-Key"] when present.

# ── Galileo Console constants (code defaults in app.py — not secrets) ────────
# Project:  rax-galileo-labs
# Stream:   trinity-stack
# Gate:     Agent Control PRE/POST Controls on this log stream (Console → Controls)
#           Create + attach a POST Control manually (this repo does not bootstrap Controls).
# Deprecated: classic Protect stage `trinity-protect` (Protect stages UI 404).
# GALILEO_PROJECT=rax-galileo-labs
# GALILEO_LOG_STREAM=trinity-stack
# GALILEO_API_URL=https://api.galileo.ai
# GALILEO_LOG_STREAM_ID=   # optional UUID; otherwise resolved via GalileoLogger

# ── Agent Control (hosted by Galileo) ────────────────────────────────────────
# AGENT_CONTROL_URL=https://agent-control.galileo.ai
# AGENT_CONTROL_AGENT_NAME=trinity-stack
# AGENT_CONTROL_TARGET_TYPE=log_stream
# AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
# AGENT_CONTROL_RUNTIME_TOKEN_HEADER=X-Agent-Control-Runtime-Token
# AGENT_CONTROL_REFRESH_SECONDS=60

# Live preflight probe (no Control create; no invoke_protect):
# GALILEO_PREFLIGHT_LIVE=1

# ── Optional — integration starters (see examples/integrations/SMOKE-RESULTS.md) ─
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# AWS_PROFILE=default
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
